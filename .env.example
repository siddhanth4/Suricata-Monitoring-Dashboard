# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Suricata IDS/IPS Ingestion
# Path to Suricata EVE JSON log file on Ubuntu (typically /var/log/suricata/eve.json)
# Or set to "sample-data/eve.json" for local testing
SURICATA_EVE_PATH="/var/log/suricata/eve.json"

# Ingestion Mode: set to "true" to enable simulated demo events if eve.json is absent
DEMO_MODE="false"

# CORS and Network Configuration
CLIENT_ORIGIN="http://localhost:3000"

# Optional Gemini API & App URL
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

