alert tcp any any -> $HOME_NET 22 (msg:"SSH Connection Attempt"; priority:3; sid:1000005; rev:2;)

#alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force"; flow:to_server; threshold:type both, track by_src, count 3, seconds 60; priority:2; sid:1000006; rev:1;)

alert tcp any any -> $HOME_NET 21 (msg:"Possible FTP Brute Force - Repeated Connection Attempts"; flags:S; flow:stateless; detection_filter:track by_src, count 10, seconds 60; priority:2; sid:1000007; rev:2;)

alert ftp $HOME_NET 21 -> any any (msg:"FTP Login Failed"; flow:established,to_client; ftp.reply; content:"Login incorrect"; priority:2; sid:1000008; rev:1;)

alert http any any -> $HOME_NET any (msg:"SQL Injection Attempt - OR 1=1 Pattern"; flow:established,to_server; http.uri; content:"1=1"; nocase; priority:1; sid:1000009; rev:2;)

alert http any any -> $HOME_NET any (msg:"Possible XSS Attempt - Script Tag in URI"; flow:established,to_server; http.uri; content:"<script"; nocase; priority:2; sid:1000010; rev:1;)

#drop http any any -> 192.168.194.132 8080 (msg:"LAB IPS block test URI"; flow:established,to_server; http.uri; content:"/ips-test-block"; startswith; sid:1000011; rev:1;)

#IPS Rules

drop http any any -> $HOME_NET 8080 (msg:"Directory Traversal Blocked"; flow:established,to_server; http.uri.raw; content:"../"; priority:1; sid:1000012; rev:1;)

drop http any any -> $HOME_NET any (msg:"Passwd File Access Blocked"; flow:established,to_server; http.uri.raw; content:"/etc/passwd"; priority:1; sid:1000013; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"PowerShell Activity Blocked"; flow:established,to_server; http.request_body; content:"powershell"; nocase; priority:1; sid:1000014; rev:1;)

drop tcp any any -> $HOME_NET any (msg:"Reverse Shell Blocked"; flow:established,to_server; content:"/bin/sh"; nocase; priority:1; sid:1000015; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"Ransomware Extension Detected"; flow:established,to_server; http.uri.raw; content:".locked"; nocase; priority:1; sid:1000016; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"SQL Injection Pattern Blocked"; flow:established,to_server; http.uri; content:"UNION SELECT"; nocase; priority:2; sid:1000019; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"Suspicious Command Parameter Blocked"; flow:established,to_server; http.uri; content:"cmd="; nocase; priority:2; sid:1000020; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"Suspicious Script Tag Blocked"; flow:established,to_server; http.request_body; content:"<script"; nocase; priority:2; sid:1000021; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"SQL Injection Boolean Pattern Blocked"; flow:established,to_server; http.uri; content:"OR"; nocase; content:"1=1"; distance:0; within:20; priority:1; sid:1000022; rev:1;)

drop http any any -> $HOME_NET 8080 (msg:"PHP Suspicious Content Blocked"; flow:established,to_server; http.request_body; content:"<?php"; nocase; content:"system("; nocase; distance:0; within:200; priority:1; sid:1000023; rev:1>

reject http any any -> $HOME_NET 8080 (msg:"Remote Code Execution Attempt Detected"; flow:established,to_server; http.request_body; content:"system("; nocase; priority:2; sid:1000017; rev:1;)

reject http any any -> $HOME_NET 8080 (msg:"PHP Web Shell Upload Attempt"; flow:established,to_server; http.request_body; content:"shell.php"; nocase; priority:2; sid:1000018; rev:2;)
