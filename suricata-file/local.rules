alert icmp any any -> $HOME_NET any (msg:"ICMP test traffic detected"; priority:3; itype:8; sid:1000001; rev:2;)

alert icmp any any -> $HOME_NET any (msg:"ICMP burst detected"; itype:8; threshold:type both, track by_src, count 20, seconds 3; priority:2; sid:1000002; rev:2;)

alert tcp any any -> $HOME_NET any (msg:"Possible SYN Scan"; flags:S; threshold:type threshold, track by_src, count 20, seconds 10; priority:2; sid:1000003; rev:1;)

alert tcp any any -> $HOME_NET any (msg:"FIN Scan Detected"; flags:F; priority:2; sid:1000004; rev:1;)

alert tcp any any -> $HOME_NET 22 (msg:"SSH Connection Attempt"; priority:3; sid:1000005; rev:2;)

#alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force"; flow:to_server; threshold:type both, track by_src, count 3, seconds 60; priority:2; sid:1000006; rev:1;)

alert tcp any any -> $HOME_NET 21 (msg:"Possible FTP Brute Force - Repeated Connection Attempts"; flags:S; flow:stateless; detection_filter:track by_src, count 10, seconds 60; priority:2; sid:1000007; rev:2;)

alert ftp $HOME_NET 21 -> any any (msg:"FTP Login Failed"; flow:established,to_client; ftp.reply; content:"Login incorrect"; priority:2; sid:1000008; rev:1;)

alert http any any -> $HOME_NET any (msg:"SQL Injection Attempt - OR 1=1 Pattern"; flow:established,to_server; http.uri; content:"1=1"; nocase; priority:1; sid:1000009; rev:2;)

alert http any any -> $HOME_NET any (msg:"Possible XSS Attempt - Script Tag in URI"; flow:established,to_server; http.uri; content:"<script"; nocase; priority:2; sid:1000010; rev:1;)
